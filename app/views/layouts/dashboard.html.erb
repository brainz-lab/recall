<!DOCTYPE html>
<html lang="en" class="h-full" data-controller="dark-mode">
<head>
  <title>Recall - <%= content_for(:title) || "Structured Logging" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%# Fonts %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet">

  <%# BrainzLab UI Design System %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "dark_mode", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <%# Chart.js for analytics - loaded in head so it's available on Turbo navigations %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>

  <style>
    :root {
      /* Recall-specific brand colors */
      --color-recall: #D97757;
      --color-recall-dark: #C4684A;
      --color-recall-light: #E89B7F;
    }
  </style>

  <%# Prevent flash of wrong theme on page load and provide toggle function %>
  <script>
    (function() {
      const savedTheme = localStorage.getItem('brainzlab-theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.add('light');
      }

      // Vanilla JS dark mode toggle - works without Stimulus
      window.toggleDarkMode = function() {
        const html = document.documentElement;
        const isDark = html.classList.contains('dark');
        if (isDark) {
          html.classList.remove('dark');
          html.classList.add('light');
          localStorage.setItem('brainzlab-theme', 'light');
        } else {
          html.classList.remove('light');
          html.classList.add('dark');
          localStorage.setItem('brainzlab-theme', 'dark');
        }
        // Update icon if exists
        const icon = document.querySelector('[data-dark-mode-target="icon"]');
        if (icon) {
          icon.innerHTML = isDark
            ? '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>'
            : '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>';
        }
      };
    })();
  </script>

  <%# Google Analytics - only in production %>
  <% if Rails.env.production? %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CXHFR6PC8W"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CXHFR6PC8W');
    </script>
  <% end %>
</head>
<body class="h-full antialiased recall-bg-page">
  <div class="flex h-full">
    <!-- Sidebar -->
    <aside class="w-64 flex flex-col recall-sidebar">
      <div class="p-5 recall-sidebar-section">
        <div class="flex items-center justify-between">
          <%= link_to dashboard_root_path, class: "flex items-center gap-2.5" do %>
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: var(--color-recall);">
              <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="8"/>
              </svg>
            </div>
            <span class="font-semibold recall-text-primary">Recall</span>
          <% end %>
          <button
            onclick="toggleDarkMode()"
            data-dark-mode-target="icon"
            class="recall-dark-mode-toggle"
            aria-label="Toggle dark mode"
            title="Toggle dark mode">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>

      <% if @project&.persisted? %>
        <%# Cache sidebar navigation - only changes when project changes or route changes %>
        <% cache(["sidebar_nav", @project.cache_key, controller_name, action_name]) do %>
        <!-- Project Selector -->
        <div class="px-4 py-3 recall-sidebar-section">
          <%= link_to dashboard_projects_path, class: "flex items-center gap-2 px-2 py-1.5 rounded-lg transition recall-text-secondary" do %>
            <div class="w-6 h-6 rounded flex items-center justify-center text-xs font-semibold" style="background: rgba(217, 119, 87, 0.15); color: var(--color-recall);">
              <%= @project.name.first.upcase %>
            </div>
            <span class="flex-1 text-sm font-medium truncate"><%= @project.name %></span>
            <svg class="w-4 h-4 recall-text-placeholder" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/>
            </svg>
          <% end %>
        </div>

        <!-- Navigation -->
        <nav class="p-4 space-y-1 flex-1">
          <%= link_to dashboard_project_logs_path(@project), class: nav_link_class('/logs') do %>
            <%= icon(:logs) %>
            Logs
          <% end %>

          <%= link_to analytics_dashboard_project_path(@project), class: nav_link_class('/analytics') do %>
            <%= icon(:analytics) %>
            Analytics
          <% end %>

          <%= link_to setup_dashboard_project_path(@project), class: nav_link_class('/setup') do %>
            <%= icon(:setup) %>
            Setup
          <% end %>

          <%= link_to mcp_setup_dashboard_project_path(@project), class: nav_link_class('/mcp') do %>
            <%= icon(:mcp) %>
            MCP
          <% end %>

          <%= link_to edit_dashboard_project_path(@project), class: nav_link_class('/settings') do %>
            <%= icon(:settings) %>
            Settings
          <% end %>
        </nav>

        <% if Rails.env.development? %>
          <div class="px-4 pb-3">
            <%= link_to dashboard_dev_tools_path, class: "nav-item" do %>
              <%= icon(:dev_tools) %>
              Dev Tools
            <% end %>
          </div>
        <% end %>
        <% end %>
      <% else %>
        <nav class="p-4 flex-1">
          <p class="px-3 text-xs font-medium uppercase tracking-wider mb-3 recall-text-placeholder">Select a project</p>
          <% if Rails.env.development? %>
            <%= link_to dashboard_dev_tools_path, class: "nav-item mt-4" do %>
              <%= icon(:dev_tools) %>
              Dev Tools
            <% end %>
          <% end %>
        </nav>
      <% end %>

      <!-- User Menu -->
      <% if defined?(current_user) && current_user %>
        <div class="p-4" style="border-top: 1px solid var(--recall-sidebar-border);">
          <div class="flex items-center gap-3">
            <div class="avatar avatar-md avatar-primary">
              <%= current_user.name&.first&.upcase || current_user.email.first.upcase %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate recall-text-primary"><%= current_user.name || current_user.email.split('@').first %></p>
              <p class="text-xs truncate recall-text-muted"><%= current_user.email %></p>
            </div>
          </div>
        </div>
      <% end %>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 overflow-auto">
      <% if notice %>
        <div class="m-8 mb-0 alert alert-success">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><%= notice %></span>
        </div>
      <% end %>
      <% if alert %>
        <div class="m-8 mb-0 alert alert-error">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
          </svg>
          <span><%= alert %></span>
        </div>
      <% end %>

      <div class="p-8">
        <%= yield %>
      </div>
    </main>
  </div>
</body>
</html>
