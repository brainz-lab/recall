<%# Log details partial - server-rendered for Turbo Frame %>
<div class="px-5 pb-4 dm-surface-alt">
  <%# JSON data section %>
  <% if log.data.present? && log.data.keys.any? %>
    <div class="mb-3 p-2 rounded dm-card">
      <%= interactive_json(log.data, "data") %>
    </div>
  <% end %>

  <%# Metadata row %>
  <div class="flex flex-wrap gap-4 text-[12px] dm-text-muted">
    <%# Session link %>
    <% if log.session_id.present? %>
      <%= link_to session_trace_dashboard_project_logs_path(@project, session_id: log.session_id),
                  class: "hover:underline cursor-pointer flex items-center gap-1 dm-text-secondary",
                  title: "View session trace",
                  data: { turbo_frame: "_top" } do %>
        <%= log_icon(:session) %>
        Session: <%= truncate(log.session_id, length: 24) %>
      <% end %>
    <% else %>
      <span>Session: —</span>
    <% end %>

    <%# Request link %>
    <% if log.request_id.present? %>
      <%= link_to trace_dashboard_project_logs_path(@project, request_id: log.request_id),
                  class: "hover:underline cursor-pointer flex items-center gap-1 dm-text-secondary",
                  title: "View request trace",
                  data: { turbo_frame: "_top" } do %>
        <%= log_icon(:request) %>
        Request: <%= log.request_id %>
      <% end %>
    <% else %>
      <span>Request: —</span>
    <% end %>

    <%# Filter buttons for metadata %>
    <% if log.branch.present? %>
      <%= log_filter_button(label: "Branch", value: log.branch, query_prefix: "branch") %>
    <% else %>
      <span>Branch: —</span>
    <% end %>

    <% if log.commit.present? %>
      <%= log_filter_button(label: "Commit", value: log.commit[0, 7], query_prefix: "commit", title: "Filter by commit #{log.commit[0, 7]}") %>
    <% end %>

    <% if log.environment.present? %>
      <%= log_filter_button(label: "Env", value: log.environment, query_prefix: "env") %>
    <% else %>
      <span>Env: —</span>
    <% end %>

    <% if log.service.present? %>
      <%= log_filter_button(label: "Service", value: log.service, query_prefix: "service") %>
    <% else %>
      <span>Service: —</span>
    <% end %>

    <% if log.host.present? %>
      <%= log_filter_button(label: "Host", value: log.host, query_prefix: "host") %>
    <% else %>
      <span>Host: —</span>
    <% end %>
  </div>
</div>
