<div class="max-w-2xl space-y-8">
  <div>
    <h1 class="text-[22px] font-semibold tracking-tight dm-text">Setup Guide</h1>
    <p class="mt-2 text-[15px] dm-text-secondary">Get started sending logs to Recall in a few minutes.</p>
  </div>

  <!-- Step 1 -->
  <div class="space-y-4">
    <div class="flex items-center gap-3">
      <span class="flex items-center justify-center w-7 h-7 rounded-full text-[13px] font-semibold recall-step-badge">1</span>
      <h2 class="text-[16px] font-medium dm-text">Add the gem to your Gemfile</h2>
    </div>
    <div class="group" style="position: relative;" data-controller="clipboard">
      <pre class="px-5 py-4 rounded-xl text-[13px] font-mono overflow-x-auto dm-code"><code>gem 'brainzlab-sdk'</code></pre>
      <button data-action="click->clipboard#copy" data-clipboard-target="source" data-copy="gem 'brainzlab-sdk'"
              class="px-3 py-1.5 text-[12px] font-medium rounded-md transition-all opacity-0 group-hover:opacity-100 dm-btn-secondary"
              style="position: absolute; top: 12px; right: 12px;">
        Copy
      </button>
    </div>
    <p class="text-[14px] dm-text-muted">Then run <code class="px-1.5 py-0.5 rounded text-[13px] dm-code">bundle install</code></p>
  </div>

  <!-- Step 2 -->
  <div class="space-y-4">
    <div class="flex items-center gap-3">
      <span class="flex items-center justify-center w-7 h-7 rounded-full text-[13px] font-semibold recall-step-badge">2</span>
      <h2 class="text-[16px] font-medium dm-text">Create an initializer</h2>
    </div>
    <p class="text-[14px] dm-text-secondary">Create <code class="px-1.5 py-0.5 rounded text-[13px] dm-code">config/initializers/recall.rb</code></p>
    <div class="group" style="position: relative;" data-controller="clipboard">
      <pre class="px-5 py-4 rounded-xl text-[13px] font-mono overflow-x-auto dm-code"><code>BrainzLab::Recall.configure do |config|
  config.key = ENV['RECALL_KEY']
  config.url = '<%= request.base_url %>'
end</code></pre>
      <button data-action="click->clipboard#copy" data-clipboard-target="source"
              data-copy="BrainzLab::Recall.configure do |config|
  config.key = ENV['RECALL_KEY']
  config.url = '<%= request.base_url %>'
end"
              class="px-3 py-1.5 text-[12px] font-medium rounded-md transition-all opacity-0 group-hover:opacity-100 dm-btn-secondary"
              style="position: absolute; top: 12px; right: 12px;">
        Copy
      </button>
    </div>
  </div>

  <!-- Step 3 -->
  <div class="space-y-4">
    <div class="flex items-center gap-3">
      <span class="flex items-center justify-center w-7 h-7 rounded-full text-[13px] font-semibold recall-step-badge">3</span>
      <h2 class="text-[16px] font-medium dm-text">Set your environment variable</h2>
    </div>
    <p class="text-[14px] dm-text-secondary">Add your ingest key to your environment:</p>
    <div class="group" style="position: relative;" data-controller="clipboard">
      <pre class="px-5 py-4 rounded-xl text-[13px] font-mono overflow-x-auto dm-code"><code>RECALL_KEY=<%= @project.ingest_key %></code></pre>
      <button data-action="click->clipboard#copy" data-clipboard-target="source"
              data-copy="RECALL_KEY=<%= @project.ingest_key %>"
              class="px-3 py-1.5 text-[12px] font-medium rounded-md transition-all opacity-0 group-hover:opacity-100 dm-btn-secondary"
              style="position: absolute; top: 12px; right: 12px;">
        Copy
      </button>
    </div>
  </div>

  <!-- Step 4 -->
  <div class="space-y-4">
    <div class="flex items-center gap-3">
      <span class="flex items-center justify-center w-7 h-7 rounded-full text-[13px] font-semibold recall-step-badge">4</span>
      <h2 class="text-[16px] font-medium dm-text">Start logging</h2>
    </div>
    <p class="text-[14px] dm-text-secondary">Use Recall anywhere in your app:</p>
    <div class="group" style="position: relative;" data-controller="clipboard">
      <pre class="px-5 py-4 rounded-xl text-[13px] font-mono overflow-x-auto dm-code"><code><span style="color: #9B8BF4;">BrainzLab::Recall</span>.info(<span style="color: #98C379;">"User signed up"</span>, user_id: user.id)

<span style="color: #9B8BF4;">BrainzLab::Recall</span>.error(<span style="color: #98C379;">"Payment failed"</span>,
  error: e.message,
  user_id: user.id,
  amount: order.total
)</code></pre>
      <button data-action="click->clipboard#copy" data-clipboard-target="source"
              data-copy="BrainzLab::Recall.info(&quot;User signed up&quot;, user_id: user.id)"
              class="px-3 py-1.5 text-[12px] font-medium rounded-md transition-all opacity-0 group-hover:opacity-100 dm-btn-secondary"
              style="position: absolute; top: 12px; right: 12px;">
        Copy
      </button>
    </div>
  </div>

  <!-- One-line setup -->
  <div class="space-y-4 p-5 rounded-xl recall-tip-box">
    <div class="flex items-center gap-2">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
      </svg>
      <h3 class="text-[15px] font-medium">One-line setup</h3>
    </div>
    <p class="text-[14px]">Want all your Rails logs sent to Recall automatically? Add this to your initializer:</p>
    <div class="group" style="position: relative;" data-controller="clipboard">
      <pre class="px-4 py-3 rounded-lg text-[13px] font-mono overflow-x-auto recall-tip-code"><code>Rails.logger = BrainzLab::Recall.logger</code></pre>
      <button data-action="click->clipboard#copy" data-clipboard-target="source"
              data-copy="Rails.logger = BrainzLab::Recall.logger"
              class="px-3 py-1.5 text-[12px] font-medium rounded-md transition-all opacity-0 group-hover:opacity-100"
              style="position: absolute; top: 8px; right: 8px; background: var(--dm-text-secondary); color: var(--dm-surface);">
        Copy
      </button>
    </div>
  </div>

  <!-- Log Levels -->
  <div class="pt-6 border-t dm-border">
    <h3 class="text-[15px] font-medium mb-4 dm-text">Available log levels</h3>
    <div class="flex flex-wrap gap-2">
      <code class="px-3 py-1.5 rounded-md text-[13px] font-mono recall-level-debug">.debug</code>
      <code class="px-3 py-1.5 rounded-md text-[13px] font-mono recall-level-info">.info</code>
      <code class="px-3 py-1.5 rounded-md text-[13px] font-mono recall-level-warn">.warn</code>
      <code class="px-3 py-1.5 rounded-md text-[13px] font-mono recall-level-error">.error</code>
      <code class="px-3 py-1.5 rounded-md text-[13px] font-mono recall-level-fatal">.fatal</code>
    </div>
  </div>

  <!-- Test it -->
  <div class="space-y-4">
    <h3 class="text-[15px] font-medium dm-text">Test your integration</h3>
    <p class="text-[14px] dm-text-secondary">Send a test log with curl:</p>
    <div class="group" style="position: relative;" data-controller="clipboard">
      <pre class="px-5 py-4 rounded-xl text-[13px] font-mono overflow-x-auto dm-code"><code>curl -X POST <%= request.base_url %>/api/v1/log \
  -H "Authorization: Bearer <%= @project.ingest_key %>" \
  -H "Content-Type: application/json" \
  -d '{"level": "info", "message": "Hello from Recall!"}'</code></pre>
      <button data-action="click->clipboard#copy" data-clipboard-target="source"
              data-copy="curl -X POST <%= request.base_url %>/api/v1/log -H &quot;Authorization: Bearer <%= @project.ingest_key %>&quot; -H &quot;Content-Type: application/json&quot; -d '{&quot;level&quot;: &quot;info&quot;, &quot;message&quot;: &quot;Hello from Recall!&quot;}'"
              class="px-3 py-1.5 text-[12px] font-medium rounded-md transition-all opacity-0 group-hover:opacity-100 dm-btn-secondary"
              style="position: absolute; top: 12px; right: 12px;">
        Copy
      </button>
    </div>
  </div>
</div>
