<div class="max-w-md space-y-10">
  <div>
    <h1 class="text-[22px] font-semibold tracking-tight mb-8 recall-text-primary">Settings</h1>
    <%= render 'form', project: @project %>
  </div>

  <div class="pt-8 recall-divider">
    <h2 class="text-[15px] font-medium mb-5 recall-text-primary">API Keys</h2>
    <div class="space-y-4">
      <div class="space-y-2">
        <label class="block text-[13px] font-medium recall-text-secondary">Ingest Key</label>
        <code class="block w-full px-4 py-3 text-[13px] font-mono rounded-lg recall-bg-input recall-text-secondary"><%= @project.ingest_key %></code>
      </div>
      <div class="space-y-2">
        <label class="block text-[13px] font-medium recall-text-secondary">API Key</label>
        <code class="block w-full px-4 py-3 text-[13px] font-mono rounded-lg recall-bg-input recall-text-secondary"><%= @project.api_key %></code>
      </div>
    </div>
  </div>

  <div class="pt-8 recall-divider">
    <h2 class="text-[15px] font-medium mb-5 recall-text-primary">Archive Management</h2>
    <p class="text-[13px] mb-4 recall-text-secondary">
      View archive status, preview logs to be archived, or manually trigger archiving.
    </p>
    <%= link_to dashboard_project_archive_path(@project), class: "inline-block px-4 py-2 text-[13px] font-medium rounded-lg recall-btn-secondary" do %>
      Manage Archive &rarr;
    <% end %>
  </div>

  <div class="pt-8 recall-divider">
    <h2 class="text-[15px] font-medium mb-5" style="color: #C94A4A;">Danger Zone</h2>
    <%= button_to 'Delete Project', dashboard_project_path(@project), method: :delete, data: { turbo_confirm: 'Are you sure? This will delete all logs.' }, class: "px-4 py-2 text-[13px] font-medium rounded-lg cursor-pointer recall-btn-danger" %>
  </div>
</div>
